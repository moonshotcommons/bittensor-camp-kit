# ==========================================================
# Bittensor 14天共学营环境变量配置模板 (.env.example)
# 如需启用 Chutes 大模型，复制为 .env 后填入：cp .env.example .env
# ==========================================================

# 1. 可选：Chutes (SN64) OpenAI 兼容接口（Day 6 选做申请，Day 9/10 矿工可选调用）
CHUTES_API_KEY=""
CHUTES_BASE_URL="https://llm.chutes.ai/v1"
CHUTES_MODEL=""

# 2. 本地教学链默认配置（setup_localnet.sh 会自动在 .localnet/ 下生成，一般无需手动改）
BT_NETWORK="local"
CAMP_MINER_WALLET="miner"
CAMP_MINER_HOTKEY="default"
CAMP_VALIDATOR_WALLET="validator"
